{
	"name": "@evomark/vue-forward-slots",
	"version": "7.0.0",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"description": "Forward slots and attributes to child components",
	"contributors": [
		"Jesse Gall",
		{
			"name": "Craig Riley",
			"email": "npm@evomark.co.uk",
			"url": "https://evomark.co.uk"
		}
	],
	"scripts": {
		"demo": "pnpm run --filter=vue-forward-slots-demo dev",
		"build": "vite build",
		"watch": "vite build --watch",
		"postbuild": "cp ./src/vue-forward-slots.d.ts ./dist/vue-forward-slots.d.ts",
		"prepublishOnly": "vitest run && npm run build",
		"test": "vitest"
	},
	"type": "module",
	"main": "dist/vue-forward-slots.cjs",
	"module": "dist/vue-forward-slots.js",
	"types": "dist/vue-forward-slots.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"dev": "./src/index.ts",
			"require": "./dist/vue-forward-slots.cjs",
			"import": "./dist/vue-forward-slots.js",
			"types": "./dist/vue-forward-slots.d.ts"
		}
	},
	"peerDependencies": {
		"vue": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"prettier": "^3.9.9",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"vue": "^3.5.43",
		"vue-eslint-parser": "^10.4.1"
	},
	"homepage": "https://github.com/evo-mark/vue-forward-slots",
	"keywords": [
		"vue",
		"vue3",
		"forward",
		"slots",
		"forward-slots"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evo-mark/vue-forward-slots.git"
	},
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
